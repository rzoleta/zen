{
  "expo": {
    "name": "Zen",
    "slug": "zen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../icon.png",
    "scheme": "zen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ryanzoleta.zen",
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "../../favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcfcfc",
          "image": "../../icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
